{
  "name": "mydocuments",
  "version": "1.0.0",
  "description": "MyDocs - lightweight document manager (Capacitor + SQLite)",
  "main": "www/js/app.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev-server.mjs",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "apk:debug": "cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alichade2/MyDocuments.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/alichade2/MyDocuments/issues"
  },
  "homepage": "https://github.com/alichade2/MyDocuments#readme",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/file-viewer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
